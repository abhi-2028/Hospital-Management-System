<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management System</title>
</head>
<body>
    <h3>Add new Hospital :</h3>
    <form action="/hospitals" method="POST">
        <input type="text" placeholder="Enter Name" name="hospital[name]">
        <br>
        <input type="text" placeholder="Enter Address" name="hospital[address]">
        <br>
        <input type="text" placeholder="Contact Number" name="hospital[contact]">
        <br>
        <input type="text" placeholder="Image URL" name="hospital[image]">
        <br>
        <button type="submit">Create Hospital</button>
    </form>
</body>
</html>