<% layout("/layouts/boilerplate") %>
<body>
    <form action="/hospitals/new" method="get">
        <button>Add Hospital</button>
    </form>
    <ul>
        <% for(let hospital of allHospitals) { %>
            <li>
                <a href="/hospitals/<%= hospital._id %>"><%= hospital.name %></a>
            </li>
        <% } %>
    </ul>
</body>
