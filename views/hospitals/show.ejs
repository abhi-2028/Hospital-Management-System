<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management System</title>
</head>

<body>
    <h3>Hospital Details :</h3>
    <ul>
        <li>
            <%= hospital.name %>
        </li>
        <li>
            <%= hospital.address %>
        </li>
        <li>
            <%= hospital.contact %>
        </li>
    </ul>
    <form action="/hospitals/<%= hospital._id %>/edit" method="get">
        <button type="submit">Edit</button>
    </form>
</body>

</html>