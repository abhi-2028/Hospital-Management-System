<% layout("/layouts/boilerplate") %>
<body>
    <h3>Hospital Details :</h3>
    <ul>
        <li>
            <%= hospital.name %>
        </li>
        <li>
            <%= hospital.address %>
        </li>
        <li>
            <%= hospital.contact %>
        </li>
    </ul>
    <form action="/hospitals/<%= hospital._id %>/edit" method="get">
        <button type="submit">Edit</button>
    </form>
    <br>
    <form action="/hospitals/<%= hospital._id %>?_method=DELETE" method="post">
        <button>Delete</button>
    </form>
</body>